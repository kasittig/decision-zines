{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/teaching-zine-ir-v1.schema.json",
  "title": "Decision-Based Teaching Zine IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "document"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": { "enum": ["google_docs", "normalized_markdown", "local_fixture"] },
        "document_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "subtitle", "components"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "const": "A Decision-Based Teaching Reconstruction" },
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "location": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "document_id": { "type": "string" },
        "structural_element_index": { "type": "integer", "minimum": 0 },
        "paragraph_index": { "type": "integer", "minimum": 0 },
        "text_start": { "type": "integer", "minimum": 0 },
        "text_end": { "type": "integer", "minimum": 0 },
        "path": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["paragraph", "option", "evidence"] },
        "text": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "pattern": "^[A-Z]$" },
        "provenance": { "enum": ["documented", "recollected", "unknown", "teaching_scenario"] }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "publication_class", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "enum": ["how_to_read", "provenance_vocabulary", "content_note", "intent", "identity", "roles", "timeline", "part", "context", "plan", "decision", "boundary", "reveal", "plan_ends", "unknown", "teaching_followup", "teaching_lesson", "teaching_question", "supporting", "reflection", "lessons", "privacy_sources_contributions", "sources"]
        },
        "publication_class": { "enum": ["published", "transform", "metadata", "editorial"] },
        "source": { "$ref": "#/$defs/location" },
        "title": { "type": "string" },
        "topic": { "type": "string" },
        "role": { "type": "string" },
        "part_number": { "type": ["integer", "string"] },
        "mode": { "enum": ["historical", "teaching_only"] },
        "decision_id": { "$ref": "#/$defs/id" },
        "plan_id": { "$ref": "#/$defs/id" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      }
    }
  }
}
